SCOOP_DATABASE_URL=postgres://scoop:scoop@127.0.0.1:5432/scoop
FULCRUM_URL=tcp://127.0.0.1:15001
SHULCRUM_URL=tcp://127.0.0.1:15011
SCOOP_BIND=127.0.0.1:3847
