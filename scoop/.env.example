# Scoop binds to localhost by default — xpubs are sensitive.
SCOOP_DATABASE_URL=postgres://scoop:scoop@127.0.0.1:5432/scoop
# Core Electrum (Fulcrum). Self-hosted Linux defaults: tcp://127.0.0.1:50001 or ssl://127.0.0.1:50002
# neop testnet4 compose: tcp://127.0.0.1:15001
FULCRUM_URL=tcp://127.0.0.1:15001
# Knots Electrum (Blake2b Fulcrum or Shulcrum). Self-hosted: tcp 50001 / ssl 50002 on the Knots host.
# StartOS: copy ssl://HOST:PORT from Fulcrum → Interfaces (Electrum SSL); ports are dynamic (not always 50002).
# Prefer LAN IP if hostname.local fails. Example: ssl://192.168.0.13:49436
SHULCRUM_URL=tcp://127.0.0.1:15011
SCOOP_BIND=127.0.0.1:3847
# StartOS uses a self-signed Electrum cert; set to 0 to enforce CA verify.
SCOOP_ELECTRUM_TLS_INSECURE=1
# Optional. Dashboard stack probe. When unset, Scoop uses ~/.neop/stack.json if it exists.
# SCOOP_STACK_CONFIG=
# CORE_RPC_URL=http://127.0.0.1:8332
# CORE_COOKIE=
# KNOTS_RPC_URL=http://127.0.0.1:15081
# Optional explorer base for tx links (no trailing slash)
# SCOOP_EXPLORER_CORE=https://mempool.space
# SCOOP_EXPLORER_KNOTS=
